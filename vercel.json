{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/digidocsmart",
      "destination": "/products/digidocsmart",
      "permanent": true
    },
    {
      "source": "/products/digicta",
      "destination": "/products/digiact",
      "permanent": true
    },
    {
      "source": "/services/manpower-outsourcing",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/digitization-of-records",
      "destination": "/services/digitization",
      "permanent": true
    },
    {
      "source": "/services/data-entry-solution",
      "destination": "/services/data-capture",
      "permanent": true
    },
    {
      "source": "/services/it-services",
      "destination": "/services/software-development",
      "permanent": true
    },
    {
      "source": "/services/ai-service",
      "destination": "/services/ai-automation",
      "permanent": true
    }
  ]
}
